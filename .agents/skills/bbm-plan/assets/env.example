# bbm-plan credentials — copy this file to `.env` and fill it in. The skill
# sources it before every run. Never commit a filled .env.

# The exact model id, as the endpoint spells it. This is what picks the
# route: the skill probes which endpoint shape serves this id and derives
# the flags from that, so `gpt-5.6-luna`, `claude-haiku-4.5` and
# `gemini-3-flash` are all valid here whether or not the repo knows them.
# Leave it empty to take the openai format's own default, `gpt-5.6-luna`.
MODEL=

# One API key — whichever endpoint serves MODEL. `BBM_API_KEY` works for
# every format; the vendor variables below are the fallbacks the run reads
# when it is unset.
BBM_API_KEY=
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=

# Custom endpoint base URL (aggregating gateways, OpenAI-compatible proxies,
# self-hosted, …). Leave unset for the format's default host. The skill probes
# the shape and fixes the path itself; give the base you were handed.
#   OpenAI shape:    https://host/v1     (the skill appends /chat/completions)
#   anthropic shape: https://host        (no /v1 — the SDK adds it)
#BBM_API_BASE=

# A gateway you use more than once belongs in a provider file rather than in
# this one. `bbm_providers.json` in the repo root is read first, then
# `~/.bbm/providers.json`; `--provider NAME` then stands in for --api_base,
# --api_format, --model/--model_list and the key variable, and anything you
# pass explicitly still wins. No secrets go in the file — `env_key` only
# names the variable to read.
#
#   {
#     "nvidia": {
#       "api_style": "openai",
#       "base_url": "https://integrate.api.nvidia.com/v1",
#       "default_models": ["moonshotai/kimi-k2-thinking"],
#       "env_key": "NVIDIA_API_KEY"
#     }
#   }
#
# api_style: openai | claude | gemini | qwen. `gemini` and `qwen` are the
# openai format at their compatibility bases, so base_url is optional there.
#NVIDIA_API_KEY=

# OrcaRouter needs no entry and no base URL: `--model orcarouter` routes
# there, `--model orcarouter/<id>` pins one of its models.
#BBM_ORCAROUTER_API_KEY=
